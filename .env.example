# Copy to .env and fill in. Never commit the real .env.

# Pinecone — free "Starter" plan at https://app.pinecone.io
PINECONE_API_KEY=

# Gemini — free tier at https://aistudio.google.com
GOOGLE_API_KEY=

# --- optional ---

# Cohere rerank (extension challenge). Absent key simply disables the feature.
# COHERE_API_KEY=

# PINECONE_INDEX=hybrid-search-lab
# Partition the single free-tier index. Test scripts set their own; leave unset
# for the default namespace in normal use.
# PINECONE_NAMESPACE=
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# Must match the Pinecone index dimension, which is fixed at creation.
# EMBEDDING_DIM=384

# Chat model: NOT gemini-2.0-flash (shut down) or gemini-2.5-flash (closed to new keys)
# GEMINI_MODEL=gemini-3.6-flash

# Chunking and fusion tuning
# CHUNK_SIZE=500
# CHUNK_OVERLAP=100
# VECTOR_WEIGHT=0.7
# BM25_WEIGHT=0.3
# RRF_K=60

# Rebuild BM25 from Pinecone at startup (set false to skip)
# REHYDRATE_ON_BOOT=true
